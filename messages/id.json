  "AboutUs": {
    "pageTitle": "Tentang Kami - Bulky.id",
    "section1": {
      "heading": "Tentang Kami",
      "card1": "Kami berkomitmen menciptakan ekosistem bisnis yang berkelanjutan, transparan, dan saling menguntungkan, antara ritel, mitra logistik, dan reseller di seluruh Indonesia.",
      "card2": "<b>Bulky.id</b> adalah perusahaan likuidasi ritel online pertama di Indonesia yang membantu bisnis mengelola kelebihan stok, barang retur, dan produk gagal kirim secara efisien.",
      "card3": "Kami menghadirkan solusi inovatif dalam pengelolaan stok, memastikan setiap produk tetap memiliki nilai jual serta membuka peluang keuntungan baru bagi pelaku usaha."
    },
    "section2": {
      "heading": "Kami Menyediakan Solusi",
      "headingLine2": "Bisnis yang Efisien"
    },
    "section3": {
      "heading": "Kami Hadir untuk Mendukung Pelaku Usaha, Reseller, dan UMKM",
      "p1": "Melalui Bulky.id, pelaku usaha dapat mendapatkan stok grosir berkualitas dengan harga lebih hemat, sekaligus memiliki kesempatan memulai bisnis tanpa modal besar.",
      "p2": "Kami juga membantu mitra meningkatkan keuntungan melalui sistem distribusi yang transparan, efisien, dan terpercaya."
    },
    "section4": {
      "heading": "Ekosistem Bulky.id",
      "p1": "Kami bekerja sama dengan ritel besar, distributor, serta mitra logistik di seluruh Indonesia. Mulai dari proses pengumpulan, penyortiran, hingga distribusi, seluruh rangkaian proses kami jalankan melalui sistem digital yang cepat dan terpercaya.",
      "p2": "Mengubah kelebihan stok menjadi peluang bisnis baru yang berkelanjutan."
    },
    "section5": {
      "heading": "Berita Bulky",
      "featuredTitle": "Ribuan Pelaku Usaha Manfaatkan Bulky.id untuk Dapatkan Stok Murah",
